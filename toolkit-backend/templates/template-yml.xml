        нет, 0, −, false — возможность покупки в розничном магазине отсутствует. -->

        <pickup>true</pickup> <!-- Доступен ли самовывоз -->
        <pickup-options> <!-- Сколько дней понадобится, чтобы привезти товар в пункт самовывоза -->
          <option days="1" order-before="14" /> <!-- Атрибут days элемента <option> внутри
          <pickup-options>. <pickup-options> может содержать до пяти <option>. -->
        </pickup-options>

        <delivery>true</delivery> <!-- Есть ли курьерская доставка для этого товара -->
        <delivery-options> <!-- Условия доставки - <delivery-options> может содержать до пяти
          <option> -->
          <option days="1" order-before="14" /> <!-- Атрибут days элемента <option> внутри
          <delivery-options>. Атрибут order-before элемента <option> внутри <delivery-options>. Атрибут
