<?xml version="1.0" encoding="UTF-8"?>
<rss xmlns:g="http://base.google.com" version="2.0">
  <channel>
    <title>Ресторан "Вкусный код"</title>
    <link>https://rest-example.com</link>
    <item>
      <!-- Вариант 1: Пицца 30 см -->
      <g:id>ID параметра товара 1</g:id>
      <g:item_group_id>ID товара 1</g:item_group_id> <!-- Общий ID для всех размеров этой пиццы -->
      <g:title>Название товара</g:title>
      <g:description>Описание товара</g:description>
      <g:link>https://rest-example.com</g:link>
      <g:image_link>https://rest-example.com/image.jpg</g:image_link>
      <g:price>450.00 RUB</g:price> <!-- Цена товара с валютой через пробел -->
      <g:availability>in_stock</g:availability> <!-- Default значение, но так же есть out_of_stock (нет в наличии), preorder (предзаказ) -->
      <g:product_type>Пицца > Классика</g:product_type> <!-- Для вложенности категорий используется " > " -->
      <g:size>30 см</g:size> <!-- Вес параметра -->
      <g:brand>Some</g:brand> <!-- Бренд товара, обязательное поле для большинства товаров, кроме еды -->
      <!--Уникальные поля Google feed-->
      <g:gtin></g:gtin> <!-- Международный код (EAN для Европы, UPC для США, ISBN для книг). -->
      <g:mpn></g:mpn> <!-- Номер детали производителя (если нет GTIN). -->
      <g:identifier_exists>no</g:identifier_exists> <!-- Если у товара нет GTIN и бренда (например, хендмейд), нужно поставить no. -->
      <g:google_product_category></g:google_product_category> <!-- Категория товара по классификации Google. Помогает системе понять контекст -->
    </item>

    <item>
      <!-- Вариант 2: Пицца 40 см -->
      <g:id>ID параметра товара 2</g:id>
      <g:item_group_id>ID товара 1</g:item_group_id>
      <g:title>Название товара</g:title>
      <g:description>Описание товара</g:description>
      <g:link>https://rest-example.com</g:link>
      <g:image_link>https://rest-example.com/image.jpg</g:image_link>
      <g:price>650.00 RUB</g:price>
      <g:availability>in_stock</g:availability>
      <g:product_type>Пицца > Классика</g:product_type>
      <g:size>40 см</g:size>
    </item>
  </channel>
</rss>